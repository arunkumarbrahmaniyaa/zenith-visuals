{
  "name": "zenith-visuals",
  "version": "0.1.0",
  "private": true,
  "description": "Zenith Visuals — the ultimate React visualization SDK.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "dev": "pnpm -r --parallel --filter \"./packages/*\" run dev",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "pnpm build && pnpm --filter @zenith-visuals/demo dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "publish:packages": "pnpm build && pnpm -r --filter \"./packages/*\" publish --access public --no-git-checks",
    "clean": "pnpm -r exec rimraf dist node_modules && rimraf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^24.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^5.0.7",
    "tsup": "^8.1.0",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
