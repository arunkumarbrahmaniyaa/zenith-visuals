{
  "name": "@zenith-visuals/charts",
  "version": "0.1.0",
  "description": "Essential, beautiful, themeable chart components (line, area, bar, pie, scatter, radar, gauge and more) for Zenith Visuals.",
  "license": "MIT",
  "keywords": [
    "react",
    "charts",
    "visualization",
    "dataviz",
    "line-chart",
    "bar-chart",
    "pie-chart",
    "scatter",
    "radar",
    "gauge",
    "zenith-visuals"
  ],
  "author": "Zenith Visuals",
  "homepage": "https://github.com/arunkumarbrahmaniyaa/zenith-visuals/tree/main/packages/charts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arunkumarbrahmaniyaa/zenith-visuals.git",
    "directory": "packages/charts"
  },
  "bugs": {
    "url": "https://github.com/arunkumarbrahmaniyaa/zenith-visuals/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@zenith-visuals/core": "workspace:*",
    "@zenith-visuals/utils": "workspace:*"
  }
}
