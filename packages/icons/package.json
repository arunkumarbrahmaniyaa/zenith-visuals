{
  "name": "@zenith-visuals/icons",
  "version": "0.1.2",
  "description": "Lightweight, tree-shakeable SVG icon components for Zenith Visuals.",
  "license": "MIT",
  "keywords": [
    "react",
    "icons",
    "svg",
    "zenith-visuals"
  ],
  "author": "Zenith Visuals",
  "homepage": "https://github.com/arunkumarbrahmaniyaa/zenith-visuals/tree/main/packages/icons#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arunkumarbrahmaniyaa/zenith-visuals.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/arunkumarbrahmaniyaa/zenith-visuals/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
