{
  "name": "@zenith-visuals/utils",
  "version": "0.1.1",
  "description": "Framework-agnostic utilities for Zenith Visuals: scales, color, math, date and array helpers.",
  "license": "MIT",
  "keywords": [
    "react",
    "visualization",
    "scales",
    "color",
    "utils",
    "zenith-visuals"
  ],
  "author": "Zenith Visuals",
  "homepage": "https://github.com/zenith-visuals/zenith-visuals/tree/main/packages/utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenith-visuals/zenith-visuals.git",
    "directory": "packages/utils"
  },
  "bugs": {
    "url": "https://github.com/zenith-visuals/zenith-visuals/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  }
}
